{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "frontend/**",
          "backend/**",
          "requirements.txt"
        ]
      }
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "frontend/**,backend/**,requirements.txt"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
